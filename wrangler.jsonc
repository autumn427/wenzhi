{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wenzhi",
  "account_id": "96b0fc65bb6cbc58cd7cebdd69a97443",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "NODE_BACKEND_ORIGIN": "https://wenzhi-origin.autumn427.xyz",
    "NODE_KEEP_ZHIHU": "false",
    "OPENAI_NEXT_BASE_URL": "https://api.openai-next.com",
    "OPENAI_NEXT_MODEL": "gpt-5.4-mini"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wenzhi-contributions",
      "database_id": "47825a87-ccc9-46e9-b518-13869599c2e6",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "wenzhi.autumn427.xyz",
      "custom_domain": true
    }
  ]
}
